# Copy to .env and fill in. Production values live in the Netlify dashboard.

# Resend (https://resend.com/api-keys) — customer confirmation + owner alert emails
RESEND_API_KEY=
# Must be on a domain verified in Resend. Use onboarding@resend.dev for testing only.
RESEND_FROM_EMAIL=
# Where new-booking alerts go
OWNER_EMAIL=

# Twilio (https://console.twilio.com) — optional SMS alerts to you + confirmation text to customer
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Admin token for list-bookings endpoint (any long random string)
ADMIN_TOKEN=

# Optional: Google review link sent after the job
GOOGLE_REVIEW_LINK=
