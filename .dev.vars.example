# Copy to .dev.vars for `npx wrangler pages dev` (local). Set the same as Secrets in the Cloudflare Pages dashboard for production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=            # only used to verify inbound webhook signatures (/api/voice, /api/sms-inbound)
TWILIO_API_KEY_SID=           # restricted API key (Messages only) used for all outbound SMS
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
OWNER_PHONE=
ADMIN_TOKEN=
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
